<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_intro"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/privacy_notice"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/cloud_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cloud_config_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/workspace_id"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:hint="@string/workspace_id_hint"
                android:imeOptions="flagNoPersonalizedLearning|actionNext"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1" />

            <EditText
                android:id="@+id/api_key"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:hint="@string/api_key_hint"
                android:imeOptions="flagNoPersonalizedLearning|actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1" />

            <Button
                android:id="@+id/save_config"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/save_cloud_config"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/config_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/primary_action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/enable_ime"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/secondary_action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/select_ime"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
